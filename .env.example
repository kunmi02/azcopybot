# Shared
NODE_ENV=development
DATABASE_URL=postgres://root:password@db:5432/copybot
PUBLIC_APP_URL=http://localhost:3000
API_PORT=8080

# Telegram
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram numeric user IDs allowed to use the bot.
ALLOWED_TELEGRAM_USER_IDS=

# FomoScan identity API
FOMOSCAN_API_KEY=
FOMOSCAN_API_BASE=https://api.fomoscan.sh

# Solana ingest / RPC
TRITON_GRPC_ENDPOINT=
TRITON_GRPC_XTOKEN=
SOLANA_RPC_URL=

# Jupiter execution
JUPITER_API_BASE=https://api.jup.ag/swap/v1
JUPITER_API_KEY=

# Optional fallback router - intentionally disabled until implemented/tested.
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=
OKX_PROJECT_ID=

# Copy-wallet bindings. No private keys in this JSON.
# Example:
# BOOTSTRAP_USERS_JSON=[{"telegramUserId":"123456789","label":"User A","signerRef":"USER_A_SOL","solanaAddress":"..."},{"telegramUserId":"987654321","label":"User B","signerRef":"USER_B_SOL","solanaAddress":"..."}]
BOOTSTRAP_USERS_JSON=[]

# Signing keys MUST be individual environment variables.
# The signerRef USER_A_SOL maps to TRADING_WALLET_USER_A_SOL_PRIVATE_KEY.
TRADING_WALLET_USER_A_SOL_PRIVATE_KEY=
TRADING_WALLET_USER_B_SOL_PRIVATE_KEY=

# Web UI
NEXT_PUBLIC_API_URL=http://localhost:8080

HELIUS_API_KEY=
SOURCING_AUTO_DISCOVERY_ENABLED=true
SOURCING_SCAN_INTERVAL_MS=600000
SOURCING_SCAN_MAX_TOKENS=3
SOURCING_MIN_LIQUIDITY_USD=10000
SOURCING_MIN_VOLUME_H1_USD=5000
SOURCING_MIN_TXNS_H1=25
SOURCING_MIN_AGE_MINUTES=5
SOURCING_MAX_AGE_HOURS=48
SOURCING_MIN_PEAK_MULTIPLE=2
